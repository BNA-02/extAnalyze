{
  "manifest_version": 2,
  "name": "Firefox Harvester",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "harvester@fixture.test"}},
  "permissions": ["<all_urls>", "cookies"],
  "background": {"scripts": ["bg.js"]},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
