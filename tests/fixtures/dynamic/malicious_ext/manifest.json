{
  "manifest_version": 3,
  "name": "Totally Legit Helper",
  "version": "1.0",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "sw.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
