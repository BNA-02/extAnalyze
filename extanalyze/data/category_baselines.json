{
  "ad_blocker": {
    "description": "Blocks ads and trackers",
    "keywords": [
      "ad block",
      "adblock",
      "adblocker",
      "ublock",
      "uorigin",
      "block ads",
      "block tracker",
      "tracker block",
      "adguard",
      "ghostery",
      "privacy badger"
    ],
    "expected_permissions": [
      "webRequest",
      "webRequestBlocking",
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess",
      "tabs",
      "storage",
      "<all_urls>",
      "webNavigation",
      "contextMenus",
      "notifications"
    ],
    "borderline_permissions": [
      "history",
      "cookies",
      "dns",
      "webRequestFilterResponse"
    ],
    "notes": "Ad blockers legitimately need broad network access. <all_urls> and webRequestBlocking are expected. History and cookies are borderline - some use them for blocking decisions. dns is borderline - used for DoH and IP-based filter list resolution. webRequestFilterResponse is used for CNAME cloaking detection in advanced ad-blockers."
  },
  "vpn_proxy": {
    "description": "VPN or proxy service",
    "keywords": [
      "vpn",
      "proxy",
      "tunnel",
      "ip address",
      "ip changer",
      "anonymizer",
      "hide ip",
      "mask ip",
      "private browsing"
    ],
    "expected_permissions": [
      "proxy",
      "storage",
      "tabs",
      "webRequest",
      "notifications",
      "alarms",
      "dns"
    ],
    "borderline_permissions": [
      "<all_urls>",
      "webNavigation"
    ],
    "notes": "Proxy permission is the core signal. webRequest for leak detection. <all_urls> for routing checks. dns is expected for DNS leak detection."
  },
  "password_manager": {
    "description": "Password and credential manager",
    "keywords": [
      "password",
      "passkey",
      "credential",
      "vault",
      "1password",
      "bitwarden",
      "lastpass",
      "dashlane",
      "keeper",
      "login manager",
      "autofill"
    ],
    "expected_permissions": [
      "activeTab",
      "storage",
      "clipboardWrite",
      "tabs",
      "contextMenus",
      "notifications"
    ],
    "borderline_permissions": [
      "scripting",
      "<all_urls>"
    ],
    "notes": "Autofill requires activeTab and scripting on specific pages. <all_urls> is borderline - some use it for form detection on any site."
  },
  "developer_tools": {
    "description": "Development utilities and browser debugging",
